@startuml C4_Elements
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Diagrama de Contenedores (C4 Nivel 2) - Sistema MediTriage
' Actualizado en ADR 0003: tecnologías genéricas reemplazadas por servicios managed

Person(paciente, "Paciente", "Ingresa sus síntomas y signos vitales en el tótem o tablet.")
Person(medico, "Personal Médico", "Enfermera de triage o Médico jefe que revisa el tablero dinámico.")

System_Boundary(meditriage, "MediTriage") {
    
    Container(spa, "Aplicación SPA Web", "React / Next.js — Vercel (Hobby Tier)", "Provee la interfaz de usuario para el registro y el tablero dinámico del personal médico. Desplegado con SSL/HTTPS por defecto.")
    
    Container(api, "API Backend", "Python / FastAPI — Render (Free Web Service)", "Orquesta la lógica, maneja WebSockets, ofusca PII y gestiona la comunicación con sistemas externos.")
    
    Container(worker_ia, "Servicio de IA (Worker)", "Python — Render (Free Background Worker)", "Procesa síntomas de forma asíncrona para sugerir la categorización ESI (1-5) y generar su justificación clínica.")
    
    ContainerDb(db, "Base de Datos Relacional", "PostgreSQL — Supabase (Free Tier, 500MB)", "Almacena perfiles, consentimientos y estado del triage. Cifrada en reposo y en tránsito.")
    
    ContainerQueue(broker, "Broker de Mensajería", "RabbitMQ — CloudAMQP (Plan Little Lemur)", "Gestiona las colas de inferencia asíncrona de IA y encola eventos para el audit log inmutable a 5 años.")
}

System_Ext(registro_civil, "Servicio de Registro Civil", "Servicio gubernamental para la validación matemática/identidad del RUT.")
System_Ext(his_ehr, "Sistema Hospitalario (HIS/EHR)", "Sistema interno de la clínica para consultar antecedentes médicos históricos.")

Rel(paciente, spa, "Ingresa datos y acepta consentimiento", "HTTPS")
Rel(medico, spa, "Visualiza tablero priorizado", "HTTPS")

Rel(spa, api, "Envía formularios y actualiza tablero en tiempo real", "JSON/HTTPS y WebSockets", $tags="port:443")
Rel(api, db, "Lee y escribe datos cifrados", "TCP/TLS", $tags="port:5432")

Rel(api, broker, "Publica solicitud de triage (PII ofuscado) y eventos de auditoría", "AMQP/TLS", $tags="port:5672")
Rel(broker, worker_ia, "Consume solicitudes de inferencia ESI", "AMQP/TLS", $tags="port:5672")
Rel(worker_ia, broker, "Publica resultado ESI y justificación clínica", "AMQP/TLS", $tags="port:5672")
Rel(broker, api, "Consume resultados resueltos para notificar vía WebSockets", "AMQP/TLS", $tags="port:5672")

Rel(api, registro_civil, "Solicita validación de RUT", "JSON/HTTPS")
Rel(api, his_ehr, "Consulta historial clínico (PII minimizado)", "HTTPS/HL7")

note right of api
  Nota operativa (ADR 0003):
  En capa gratuita de Render, el servicio
  entra en "spin down" tras 15 min sin
  tráfico (cold start en la siguiente
  petición). Aceptable para MVP académico.
end note

SHOW_LEGEND()
@enduml

@startuml l1-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Contexto del Sistema (C4 Nivel 1) — MediTriage

Person(paciente, "Paciente", "Persona que acude a urgencias; ingresa identificación y consentimiento informado.")
Person(enfermera, "Enfermera de Triage", "Registra síntomas y signos vitales; valida sugerencia ESI generada por IA.")
Person(medico_auditor, "Médico Jefe / Auditor Clínico", "Monitorea la sala de espera en tiempo real y audita logs de decisiones de la IA.")

System(meditriage, "MediTriage", "Sistema de priorización de urgencias asistido por IA explicable con categorización ESI (1-5).")

System_Ext(reg_civil, "Servicio de Registro Civil", "API externa para validación oficial de RUN e identidad.")
System_Ext(his, "Sistema Hospitalario (HIS/EHR)", "Gestión de ficha clínica electrónica, boxes y admisión hospitalaria.")

Rel(paciente, meditriage, "Ingresa RUT y otorga consentimiento informado", "HTTPS")
Rel(enfermera, meditriage, "Registra constantes vitales y valida sugerencia ESI", "HTTPS")
Rel(medico_auditor, meditriage, "Supervisa tablero dinámico y audita logs inmutables", "HTTPS")

Rel(meditriage, reg_civil, "Valida identidad de pacientes", "HTTPS / REST")
Rel(meditriage, his, "Sincroniza orden de atención y derivación a box", "HL7 FHIR / REST")

@enduml
